// The UniFFI interface definition for ulite-editor-core — the contract
// `scripts/build-ffi.sh` generates Kotlin bindings from. Changes here must
// be mirrored in `ffi.rs` (Rust side) and in the Kotlin sample app.
//
// Design notes:
// - Byte offsets travel as `u64` (`f32` only for pixel geometry): the
//   engine stays `usize`/byte-indexed, and the bridge widens at the edge,
//   exactly the adjustment made for the own-`CursorPosition` name clash.
// - No glyph-space geometry crosses this boundary: text is measured and
//   laid out by the Compose renderer (real glyph widths, bidi, shaping),
//   whose results only it can produce. The engine owns the
//   direction-agnostic byte math — buffer, cursor, edits, and the scroll
//   camera.

namespace ulite_editor_core {
};

dictionary CursorPosition {
  u64 row;
  u64 column;
};

interface EditorSession {
  constructor();
  CursorPosition cursor();
  void set_cursor(CursorPosition position);
  void insert_char(string ch);
  void insert_text(string text);
  void newline();
  void backspace();
  void replace_content(string text);

  u64 row_count();
  string line_text(u64 row);
  string buffer_text();

  f32 scroll_x();
  f32 scroll_y();
  void update_bounds(f32 content_width, f32 content_height, f32 viewport_width, f32 viewport_height);
  boolean ensure_visible(f32 cursor_x, f32 cursor_y, f32 line_height, f32 viewport_width, f32 viewport_height);
  boolean follow_caret_after_edit(f32 caret_x, f32 caret_y, f32 line_height, f32 viewport_width, f32 viewport_height);
  void scroll_by(f32 dx, f32 dy);
  void set_scroll(f32 x, f32 y);
  void start_fling(f32 velocity_x, f32 velocity_y);
  boolean tick_fling(f32 dt_seconds);
};